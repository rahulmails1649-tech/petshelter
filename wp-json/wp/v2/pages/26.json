{"id":26,"date":"2026-08-11T11:04:56","date_gmt":"2026-08-11T11:04:56","guid":{"rendered":"https:\/\/gurlypets.online\/faq\/"},"modified":"2026-08-11T11:04:56","modified_gmt":"2026-08-11T11:04:56","slug":"faq","status":"publish","type":"page","link":"https:\/\/gurlypets.online\/faq\/","title":{"rendered":"FAQ"},"content":{"rendered":"\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section has-background-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-8870cb56 wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--section--1\" id=\"faq\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\">\n<h2 class=\"wp-block-heading has-text-align-center\">What types of pets do you rescue?<\/h2>\n\n\n\n<p class=\"has-text-align-center ext-animate--on wp-block-paragraph\" style=\"margin-top:1.5rem\">Find clear and friendly answers to the most common questions about our shelter and adoption process.<\/p>\n\n\n\n<div class=\"wp-block-group alignwide has-global-padding is-content-justification-center is-layout-constrained wp-container-core-group-is-layout-a192b366 wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on is-layout-flow wp-block-group-is-layout-flow is-style-ext-preset--group--natural-1--item-card-1--align-start--2\">\n<div class=\"wp-block-group is-style-default is-layout-flow wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading\">How can I adopt a pet from Pet Shelter?<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">You can start by visiting our shelter or browsing available pets online, then complete an adoption application.<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on is-layout-flow wp-block-group-is-layout-flow is-style-ext-preset--group--natural-1--item-card-1--align-start--3\">\n<div class=\"wp-block-group is-style-default is-layout-flow wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading\">Do you accept donations and how can I contribute?<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Yes, we welcome donations of supplies, funds, and volunteer time to support our animals.<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on is-layout-flow wp-block-group-is-layout-flow is-style-ext-preset--group--natural-1--item-card-1--align-start--4\">\n<div class=\"wp-block-group is-style-default is-layout-flow wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading\">Can I volunteer at the shelter?<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Absolutely! We are always looking for caring volunteers to help with daily activities and events.<\/p>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on is-layout-flow wp-block-group-is-layout-flow is-style-ext-preset--group--natural-1--item-card-1--align-start--5\">\n<div class=\"wp-block-group is-style-default is-layout-flow wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading\">What health checks do pets undergo before adoption?<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">All our pets receive thorough veterinary care, vaccinations, and are spayed or neutered before adoption.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section ext-animate--on has-tertiary-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--section--6\" id=\"contact\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\">\n<