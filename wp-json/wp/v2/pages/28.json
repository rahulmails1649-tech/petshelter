{"id":28,"date":"2026-08-11T11:04:57","date_gmt":"2026-08-11T11:04:57","guid":{"rendered":"https:\/\/gurlypets.online\/services\/"},"modified":"2026-08-11T11:05:23","modified_gmt":"2026-08-11T11:05:23","slug":"services","status":"publish","type":"page","link":"https:\/\/gurlypets.online\/services\/","title":{"rendered":"Services"},"content":{"rendered":"\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section has-background-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-8870cb56 wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--section--1\" id=\"services\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\">\n<h2 class=\"wp-block-heading has-text-align-center ext-animate--on\">Explore Our Care and Adoption Services<\/h2>\n\n\n\n<p class=\"has-text-align-center ext-animate--on wp-block-paragraph\" style=\"margin-top:1.5rem\">Discover the compassionate support and assistance we offer to rescue, care for, and find loving homes for abandoned pets.<\/p>\n\n\n\n<div class=\"wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-9705efd8 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column ext-animate--on is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-center has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--item-card-1--align-center--2\">\n<figure class=\"wp-block-image extendify-image-import\"><img decoding=\"async\" src=\"https:\/\/images.unsplash.com\/photo-1582530182198-98b5312880f6?orientation=landscape?fit=crop&amp;crop=entropy%2Cfaces&amp;auto=format%2Ccompress&amp;w=1280\" alt=\"\" style=\"aspect-ratio:4\/3;object-fit:cover\"\/><\/figure>\n\n\n\n<div class=\"wp-block-group is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading has-text-align-center\">Rescue and Rehabilitation<\/h3>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\">We safely rescue abandoned or injured pets, providing medical care and rehabilitation to restore their health.<\/p>\n<\/div>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-column ext-animate--on is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-center has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--item-card-1--align-center--3\">\n<figure class=\"wp-block-image extendify-image-import\"><img decoding=\"async\" src=\"https:\/\/images.unsplash.com\/photo-1753685723996-7af154157cf6?orientation=landscape?fit=crop&amp;crop=entropy%2Cfaces&amp;auto=format%2Ccompress&amp;w=1280\" alt=\"\" style=\"aspect-ratio:4\/3;object-fit:cover\"\/><\/figure>\n\n\n\n<div class=\"wp-block-group is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading has-text-align-center\">Safe Shelter and Daily Care<\/h3>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\">Our shelter offers a secure, nurturing environment where pets receive food, comfort, and ongoing attention.<\/p>\n<\/div>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-column ext-animate--on is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-center has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--item-card-1--align-center--4\">\n<figure class=\"wp-block-image extendify-image-import\"><img decoding=\"async\" src=\"https:\/\/images.unsplash.com\/photo-1570018143038-6f4c428f6e3e?orientation=portrait?fit=crop&amp;crop=entropy%2Cfaces&amp;auto=format%2Ccompress&amp;w=1280\" alt=\"\" style=\"aspect-ratio:4\/3;object-fit:cover\"\/><\/figure>\n\n\n\n<div class=\"wp-block-group is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading has-text-align-center\">Adoption and Community Outreach<\/h3>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\">We connect pets with loving families and educate the community about responsible pet ownership and care.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section has-tertiary-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-8870cb56 wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--section--5\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\">\n<div class=\"wp-block-group alignwide ext-is-logical-start has-global-padding is-content-justification-left is-layout-constrained wp-container-core-group-is-layout-4e8e568a wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading ext-animate--on\">Our Process<\/h2>\n\n\n\n<p class=\"has-text-align-left ext-animate--on wp-block-paragraph\">Discover how we rescue, care for, and find loving homes for abandoned pets through each thoughtful step.<\/p>\n<\/div>\n\n\n\n<div class=\"wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-e2b55219 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-stretch is-layout-flow wp-container-core-column-is-layout-02ccbb15 wp-block-column-is-layout-flow\">\n<div class=\"wp-block-cover is-style-ext-preset--image--natural-1--image-1--content-right ext-animate--on extendify-image-import is-style-ext-preset--image--natural-1--image-1--content-right--6\" style=\"padding-top:0;padding-bottom:0;min-height:100%;aspect-ratio:unset;\"><img decoding=\"async\" class=\"wp-block-cover__image-background\" alt=\"\" src=\"https:\/\/images.unsplash.com\/photo-1632498301446-5f78baad40d0?orientation=portrait?fit=crop&amp;crop=entropy%2Cfaces&amp;auto=format%2Ccompress&amp;w=1280\" data-object-fit=\"cover\"\/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"><\/span><div class=\"wp-block-cover__inner-container is-layout-flow wp-block-cover-is-layout-flow\">\n<div style=\"height:240px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n<\/div><\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-container-core-column-is-layout-ff1e87f5 wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--item-card-1--align-start--7\">\n<div class=\"wp-block-group is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-0f823597 wp-block-group-is-layout-flex\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<figure class=\"wp-block-image size-large ext-aspect-landscape extendify-image-import wp-duotone-primary-foreground\"><img decoding=\"async\" src=\"data:image\/svg+xml;base64,\" alt=\"\" style=\"object-fit:cover\"\/><\/figure>\n\n\n\n<div class=\"wp-block-group wp-container-content-958eb9dc has-global-padding is-layout-constrained wp-container-core-group-is-layout-527b40bc wp-block-group-is-layout-constrained\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<h3 class=\"wp-block-heading\">Step One: Rescue and Care<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">We prioritize the safety and well-being of each pet with compassionate sheltering and medical attention.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--item-card-1--align-start--8\">\n<div class=\"wp-block-group is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-0f823597 wp-block-group-is-layout-flex\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<figure class=\"wp-block-image size-large ext-aspect-landscape extendify-image-import wp-duotone-primary-foreground\"><img decoding=\"async\" src=\"data:image\/svg+xml;base64,\" alt=\"\" style=\"object-fit:cover\"\/><\/figure>\n\n\n\n<div class=\"wp-block-group wp-container-content-958eb9dc has-global-padding is-layout-constrained wp-container-core-group-is-layout-527b40bc wp-block-group-is-layout-constrained\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<h3 class=\"wp-block-heading\">Step Two: Foster and Support<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Providing temporary homes and support to help pets thrive while awaiting adoption.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-group is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on has-global-padding is-layout-constrained wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--item-card-1--align-start--9\">\n<div class=\"wp-block-group is-style-default has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-0f823597 wp-block-group-is-layout-flex\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<figure class=\"wp-block-image size-large ext-aspect-landscape extendify-image-import wp-duotone-primary-foreground\"><img decoding=\"async\" src=\"data:image\/svg+xml;base64,\" alt=\"\" style=\"object-fit:cover\"\/><\/figure>\n\n\n\n<div class=\"wp-block-group wp-container-content-958eb9dc has-global-padding is-layout-constrained wp-container-core-group-is-layout-527b40bc wp-block-group-is-layout-constrained\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\">\n<h3 class=\"wp-block-heading\">Step Three: Adoption Opportunities<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Helping pets find permanent families through personalized matchmaking and community events.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section has-background-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-8870cb56 wp-block-group-is-layout-constrained is-style-ext-preset--group--natural-1--section--10\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\">\n<div class=\"wp-block-media-text alignwide is-stacked-on-mobile is-image-fill-element is-style-ext-preset--media-text--natural-1--card-1 ext-animate--on has-tertiary-background-color has-background extendify-image-import is-style-ext-preset--media-text--natural-1--card-1--11\"><figure class=\"wp-block-media-text__media\"><img decoding=\"async\" src=\"https:\/\/images.unsplash.com\/photo-1692224749799-945a5f43acbc?orientation=landscape?fit=crop&amp;crop=entropy%2Cfaces&amp;auto=format%2Ccompress&amp;w=1280\" alt=\"\" style=\"object-position:50% 50%\"\/><\/figure><div class=\"wp-block-media-text__content\">\n<div class=\"wp-block-group alignwide is-vertical is-layout-flex wp-container-core-group-is-layout-37796f56 wp-block-group-is-layout-flex\" style=\"padding-top:var(--wp--preset--spacing--60)